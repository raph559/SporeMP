<Window x:Class="SporeMP.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SporeMP" Width="1280" Height="820" MinWidth="1060" MinHeight="700"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        Background="#080F1B" FontFamily="Segoe UI" FontSize="14" Foreground="{StaticResource Text}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display"
        Loaded="OnLoaded" Closing="OnClosing" PreviewKeyDown="WindowKeyDown">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0"
                  CornerRadius="12" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>
  <Border BorderBrush="#2A384B" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="212" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="*" /></Grid.RowDefinitions>

      <Border Grid.RowSpan="2" Background="#0D1725" BorderBrush="#233146" BorderThickness="0,0,1,0">
        <Grid Margin="17,26,17,22">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <StackPanel Margin="13,0,0,39">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="S P O R E" FontSize="21" FontWeight="Bold" />
              <Border Background="{StaticResource Accent}" CornerRadius="4" Padding="5,3" Margin="9,2,0,0" VerticalAlignment="Top">
                <TextBlock Text="MP" FontSize="10" FontWeight="ExtraBold" Foreground="#142034" />
              </Border>
            </StackPanel>
            <TextBlock Text="A universe worth sharing." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,8,0,0" />
          </StackPanel>
          <StackPanel Grid.Row="1">
            <TextBlock Text="YOUR LAUNCHER" FontSize="9" FontWeight="SemiBold" Foreground="#7D90AA" Margin="15,0,0,14" />
            <Button Style="{StaticResource NavButton}" Tag="{Binding IsHome}" Click="PlayTabClick" ToolTip="Home · Ctrl+1" AutomationProperties.Name="Home">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="31" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons" FontSize="17" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Home" />
              </Grid>
            </Button>
            <Button Style="{StaticResource NavButton}" Tag="{Binding IsUpdates}" Click="UpdatesClick" ToolTip="What's new · Ctrl+2" AutomationProperties.Name="What's new">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="31" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons" FontSize="17" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="What's new" />
              </Grid>
            </Button>
            <Button x:Name="SettingsButton" Style="{StaticResource NavButton}" Tag="{Binding IsSettings}" Click="SettingsClick" ToolTip="Settings · Ctrl+," AutomationProperties.Name="Settings">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="31" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="17" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Settings" />
              </Grid>
            </Button>
          </StackPanel>
          <StackPanel Grid.Row="2" Margin="12,0,12,0">
            <Border Height="1" Background="#29384C" Margin="0,0,0,20" />
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="17" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Ellipse Width="6" Height="6" Fill="{Binding StatusBrush}" VerticalAlignment="Top" Margin="0,6,0,0" HorizontalAlignment="Left" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding LauncherStatusTitle}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding GameName}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
              </StackPanel>
            </Grid>
            <TextBlock Text="{Binding VersionLabel, StringFormat='Development build · {0}'}" FontSize="10" Foreground="#8395AF" Margin="17,22,0,0" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Column="1" Margin="29,0,7,0">
        <TextBlock Text="THE SPORE MULTIPLAYER PROJECT" FontSize="9" Foreground="#8597B0" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Content="&#xE921;" FontFamily="Segoe Fluent Icons" FontSize="11" Width="40" Height="32" Padding="0" Style="{StaticResource QuietButton}" Click="MinimizeClick" ToolTip="Minimize" AutomationProperties.Name="Minimize" />
          <Button Content="&#xE922;" FontFamily="Segoe Fluent Icons" FontSize="11" Width="40" Height="32" Padding="0" Style="{StaticResource QuietButton}" Click="MaximizeClick" ToolTip="Maximize or restore" AutomationProperties.Name="Maximize or restore" />
          <Button Content="&#xE8BB;" FontFamily="Segoe Fluent Icons" FontSize="11" Width="40" Height="32" Padding="0" Style="{StaticResource QuietButton}" Click="CloseClick" ToolTip="Close" AutomationProperties.Name="Close" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" Grid.Column="1">
        <ScrollViewer x:Name="HomePage" Visibility="{Binding HomeVisibility}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="30,19,30,24">
            <Grid Margin="0,0,0,21">
              <TextBlock Text="Make yourself at home." FontSize="28" FontWeight="SemiBold" />
              <Border Background="#152336" BorderBrush="#2C4059" BorderThickness="1" CornerRadius="6" Padding="10,5" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="ORIGINAL SPORE" FontSize="9" FontWeight="SemiBold" Foreground="#BCCCE0" />
              </Border>
            </Grid>
            <Border CornerRadius="16" Height="356" BorderBrush="#3B4B62" BorderThickness="1">
              <Border.Background><ImageBrush ImageSource="Assets/universe.png" Stretch="UniformToFill" AlignmentX="Right" RenderOptions.BitmapScalingMode="HighQuality" /></Border.Background>
              <Border CornerRadius="15">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="#F50A1525" Offset="0" />
                    <GradientStop Color="#ED0A1525" Offset="0.27" />
                    <GradientStop Color="#9C0A1525" Offset="0.53" />
                    <GradientStop Color="#120A1525" Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="32,27,32,25">
                  <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <StackPanel Width="388" HorizontalAlignment="Left">
                    <TextBlock Text="FROM YOUR FIRST CELL TO THE STARS" Style="{StaticResource Eyebrow}" />
                    <TextBlock Text="Your next&#10;great adventure." FontFamily="Segoe UI Variable Display" FontWeight="Bold" FontSize="46" LineHeight="51" Margin="0,14,0,11" />
                    <TextBlock Text="A familiar world. A new beginning.&#10;Pick up where you left off." FontSize="14" Foreground="#C3D0E2" LineHeight="22" />
                  </StackPanel>
                  <StackPanel Grid.Row="1" HorizontalAlignment="Left">
                    <Button x:Name="PrimaryButton" Width="264" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanPrimary}" Click="PrimaryClick" AutomationProperties.Name="{Binding PrimaryLabel}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding PrimaryIcon}" FontFamily="Segoe Fluent Icons" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding PrimaryLabel}" TextWrapping="NoWrap" />
                      </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding PrimaryHint}" FontSize="11" Foreground="#BBCAE0" Margin="1,9,0,0" />
                  </StackPanel>
                  <Button Grid.Row="1"
                          HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource QuietButton}"
                          Foreground="#ECD2AA" FontSize="12" Click="SettingsClick" AutomationProperties.Name="Display settings">
                    <TextBlock Text="{Binding Display.Summary, StringFormat='Display: {0}  →'}" />
                  </Button>
                </Grid>
              </Border>
            </Border>
            <Border Style="{StaticResource Card}" CornerRadius="11" Padding="18,13" Margin="0,14,0,17">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" VerticalAlignment="Top" Margin="0,6,0,0" HorizontalAlignment="Left" />
                <StackPanel Grid.Column="1" Margin="0,0,18,0">
                  <TextBlock Text="{Binding LauncherStatusTitle}" FontSize="14" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
                  <TextBlock Text="{Binding LauncherStatusDetail}" Style="{StaticResource Small}" FontSize="12" Margin="0,4,0,0" />
                  <ProgressBar Height="2" Margin="0,9,0,1" IsIndeterminate="True" Visibility="{Binding BusyVisibility}" Foreground="{StaticResource Accent}" Background="#2C3B50" />
                </StackPanel>
                <Button Grid.Column="2" Content="{Binding DetailsLabel}" Style="{StaticResource QuietButton}" Click="SettingsClick" FontSize="12" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Padding="22,19" Margin="0,0,0,18" BorderBrush="#36534F">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="250" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,24,0">
                  <TextBlock Text="PRIVATE MULTIPLAYER · EXPERIMENTAL" Style="{StaticResource Eyebrow}" Foreground="#96D8C8" />
                  <TextBlock Text="{Binding Multiplayer.ServerLabel}" FontSize="22" FontWeight="SemiBold" Margin="0,9,0,7" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Multiplayer.Status}" FontSize="13" Foreground="#96D8C8" AutomationProperties.LiveSetting="Polite" />
                  <TextBlock Text="{Binding Multiplayer.Detail}" Style="{StaticResource Small}" FontSize="12" Margin="0,6,0,0" />
                  <TextBlock Text="{Binding JoinAvailabilityDetail}" FontSize="12" Foreground="#F1CB8A" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <PasswordBox x:Name="InvitationBox" MaxLength="2048" PasswordChanged="InvitationChanged" IsEnabled="{Binding Multiplayer.CanEdit}" Padding="10,9" FontSize="12" Background="#0D1725" Foreground="#C5D1E2" BorderBrush="#3D526B" AutomationProperties.Name="Private server invitation" ToolTip="Paste the complete private invitation from your host. It is kept only while this launcher is open." />
                    <Button Grid.Column="1" Content="Paste" Click="PasteInvitationClick" IsEnabled="{Binding Multiplayer.CanEdit}" Margin="6,0,0,0" Padding="10,8" FontSize="12" ToolTip="Paste an invitation from the clipboard" />
                  </Grid>
                  <Button x:Name="JoinButton" Content="{Binding Multiplayer.ButtonLabel}" Click="JoinClick" IsEnabled="{Binding CanJoin}" Margin="0,9,0,0" Padding="16,11" Background="#294D45" BorderBrush="#4D7D6E" Foreground="#DEF6E9" AutomationProperties.Name="{Binding Multiplayer.ButtonLabel}" />
                  <TextBlock Text="Invite remembered until you close the launcher." FontSize="10" Foreground="{StaticResource Muted}" Margin="0,7,0,0" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </Border>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Button Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}" Padding="22,19" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" Click="ReadLatestClick" AutomationProperties.Name="Read the latest update">
                <StackPanel>
                  <Grid>
                    <TextBlock Text="LATEST UPDATE" Style="{StaticResource Eyebrow}" />
                    <TextBlock Text="{Binding LatestUpdate.VersionLabel}" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" />
                  </Grid>
                  <TextBlock Text="{Binding LatestUpdate.Title}" FontSize="20" FontWeight="SemiBold" Margin="0,10,0,7" />
                  <TextBlock Text="{Binding LatestUpdate.Summary}" Style="{StaticResource Small}" FontWeight="Normal" />
                  <Grid Margin="0,15,0,0">
                    <TextBlock Text="{Binding LatestUpdate.DateLabel}" FontSize="11" FontWeight="Normal" Foreground="{StaticResource Muted}" />
                    <TextBlock Text="Read update  →" FontSize="12" Foreground="{StaticResource Accent}" HorizontalAlignment="Right" />
                  </Grid>
                </StackPanel>
              </Button>
              <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22,19">
                <StackPanel>
                  <TextBlock Text="THE JOURNEY AHEAD" Style="{StaticResource Eyebrow}" Foreground="#96D8C8" />
                  <TextBlock Text="A universe worth sharing." FontSize="20" FontWeight="SemiBold" Margin="0,10,0,7" />
                  <TextBlock Text="Private multiplayer is taking its first steps. The full journey from Cell to Space is still in development." Style="{StaticResource Small}" />
                  <TextBlock Text="Your game. Your existing saves." FontSize="11" Foreground="#96D8C8" Margin="0,15,0,0" />
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </ScrollViewer>

        <Grid x:Name="UpdatesPage" Visibility="{Binding UpdatesVisibility}" Margin="30,19,30,24">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Grid>
            <StackPanel Margin="0,0,300,0">
              <TextBlock Text="What's new" FontSize="28" FontWeight="SemiBold" />
              <TextBlock Text="Every update. All in one place." Style="{StaticResource Small}" Margin="0,7,0,0" />
            </StackPanel>
            <Grid Width="272" HorizontalAlignment="Right" VerticalAlignment="Center">
              <TextBox x:Name="ReleaseSearchBox" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                       Padding="36,12,35,12" AutomationProperties.Name="Search release notes" ToolTip="Search versions and changes · Ctrl+F" />
              <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{StaticResource Muted}" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
              <TextBlock Text="Search updates…" FontSize="13" Foreground="{StaticResource Muted}" Margin="37,0,0,0" VerticalAlignment="Center" Visibility="{Binding SearchPlaceholderVisibility}" IsHitTestVisible="False" />
              <Button Content="&#xE8BB;" FontFamily="Segoe Fluent Icons" FontSize="10" Width="30" Padding="0" Margin="0,4,5,4" HorizontalAlignment="Right" Style="{StaticResource QuietButton}" Click="ClearSearchClick" Visibility="{Binding ClearSearchVisibility}" ToolTip="Clear search" AutomationProperties.Name="Clear search" />
            </Grid>
          </Grid>
          <Grid Grid.Row="1" Margin="0,27,0,14">
            <TextBlock Text="{Binding UpdateCountLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
            <TextBlock Text="Included with this launcher · available offline" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" />
          </Grid>
          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="224" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <ListBox ItemsSource="{Binding VisibleUpdates}" SelectedItem="{Binding SelectedUpdate, Mode=TwoWay}" AutomationProperties.Name="Release history">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel>
                    <Grid>
                      <TextBlock Text="{Binding VersionLabel}" FontSize="17" FontWeight="SemiBold" />
                      <Border Background="#294137" CornerRadius="4" Padding="5,3" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{Binding IsCurrentVersion, Converter={StaticResource BoolVisibility}}">
                        <TextBlock Text="INSTALLED" FontSize="8" FontWeight="SemiBold" Foreground="#AFE4CC" />
                      </Border>
                    </Grid>
                    <TextBlock Text="{Binding Title}" FontSize="13" Foreground="#C5D1E2" Margin="0,9,0,7" />
                    <TextBlock Text="{Binding DateLabel}" FontSize="11" Foreground="{StaticResource Muted}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Grid Grid.Column="2" Visibility="{Binding SelectedUpdateVisibility}">
              <Border Style="{StaticResource Card}" Padding="0" DataContext="{Binding SelectedUpdate}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Margin="28">
                    <Grid>
                      <Border Background="#26394D" CornerRadius="5" Padding="9,5" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding VersionLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                      </Border>
                      <TextBlock Text="{Binding DateLabel}" FontSize="12" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="{Binding Title}" FontSize="29" FontWeight="SemiBold" Margin="0,22,0,11" />
                    <TextBlock Text="{Binding Summary}" FontSize="15" Foreground="#BFCCDD" LineHeight="24" />
                    <Border Height="1" Background="#2B3C52" Margin="0,26,0,26" />
                    <TextBlock Text="IN THIS UPDATE" Style="{StaticResource Eyebrow}" Margin="0,0,0,23" />
                    <ItemsControl ItemsSource="{Binding Changes}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Background="#385A6D" CornerRadius="2" />
                            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                              <TextBlock Text="{Binding Category}" FontSize="9" FontWeight="SemiBold" Foreground="#96D8C8" Margin="0,0,0,7" />
                              <TextBlock Text="{Binding Text}" FontSize="14" Foreground="#D1DBE9" LineHeight="23" />
                            </StackPanel>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ScrollViewer>
              </Border>
            </Grid>
            <Border Grid.Column="2" Style="{StaticResource Card}" Visibility="{Binding EmptyUpdatesVisibility}">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="320">
                <TextBlock Text="No updates found" FontSize="24" FontWeight="SemiBold" TextAlignment="Center" />
                <TextBlock Text="Try a version number or a word like ‘play’ or ‘settings’." Style="{StaticResource Small}" TextAlignment="Center" Margin="0,12,0,20" />
                <Button Content="Clear search" Click="ClearSearchClick" HorizontalAlignment="Center" />
              </StackPanel>
            </Border>
          </Grid>
        </Grid>

        <ScrollViewer x:Name="SettingsPage" Visibility="{Binding SettingsVisibility}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="30,19,30,24">
            <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Your game, just the way you left it." Style="{StaticResource Small}" Margin="0,7,0,25" />
            <Border Style="{StaticResource Card}" Margin="0,0,0,18">
              <StackPanel>
                <TextBlock Text="MULTIPLAYER CONNECTION" Style="{StaticResource Eyebrow}" />
                <TextBlock Text="{Binding Multiplayer.Status}" FontSize="22" FontWeight="SemiBold" Margin="0,10,0,9" />
                <TextBlock Text="Invitations are private: each one identifies a player and the server certificate to trust. Rejoin uses the same invitation. Full campaign progression and Internet hosting setup are still in development." Style="{StaticResource Small}" />
                <TextBlock Text="{Binding Multiplayer.TechnicalDetail}" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,12,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,18" DataContext="{Binding Display}">
              <StackPanel>
                <TextBlock Text="DISPLAY" Style="{StaticResource Eyebrow}" />
                <TextBlock Text="Start with the right view." FontSize="22" FontWeight="SemiBold" Margin="0,10,0,6" />
                <TextBlock Text="Set how SPORE opens on your primary display." Style="{StaticResource Small}" Margin="0,0,0,19" />
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="0.8*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="1.2*" /></Grid.ColumnDefinitions>
                  <StackPanel>
                    <Label Content="Display _mode" Target="{Binding ElementName=DisplayModeBox}" Foreground="{StaticResource Muted}" Padding="0,0,0,8" FontSize="12" />
                    <ComboBox x:Name="DisplayModeBox" ItemsSource="{Binding Modes}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedMode}"
                              IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Display mode" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <Label Content="_Resolution" Target="{Binding ElementName=ResolutionBox}" Foreground="{StaticResource Muted}" Padding="0,0,0,8" FontSize="12" />
                    <ComboBox x:Name="ResolutionBox" ItemsSource="{Binding Resolutions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedResolution}"
                              IsEnabled="{Binding CanChooseResolution}" AutomationProperties.Name="Game resolution" />
                  </StackPanel>
                </Grid>
                <WrapPanel Margin="0,18,0,0">
                  <Button x:Name="SaveDisplayButton" Content="{Binding SaveLabel}" IsEnabled="{Binding CanSave}" Click="SaveDisplayClick" Margin="0,0,10,0" />
                  <Button Content="Refresh display" IsEnabled="{Binding CanReload}" Click="ReloadDisplayClick" Style="{StaticResource QuietButton}" />
                </WrapPanel>
                <TextBlock Text="{Binding Message}" Style="{StaticResource Small}" FontSize="12" Foreground="#96D8C8" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="GAME INSTALLATION" Style="{StaticResource Eyebrow}" />
                <TextBlock Text="{Binding GameName}" FontSize="22" FontWeight="SemiBold" Margin="0,13,0,13" />
                <TextBox Text="{Binding GameRoot, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="Detected game path" />
                <WrapPanel Margin="0,14,0,0">
                  <Button Content="Choose game folder" Click="BrowseClick" IsEnabled="{Binding CanRun}" Margin="0,0,10,0" />
                  <Button Content="Check again" Click="RetryClick" IsEnabled="{Binding CanRun}" Style="{StaticResource QuietButton}" />
                </WrapPanel>
                <StackPanel Visibility="{Binding ChoicesVisibility}" Margin="0,23,0,0">
                  <TextBlock Text="Multiple installations found" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
                  <ListBox x:Name="InstallationChoices" ItemsSource="{Binding Installations}" SelectedIndex="0" MaxHeight="190" IsEnabled="{Binding CanRun}" AutomationProperties.Name="SPORE installations">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel>
                          <TextBlock Text="{Binding Store}" FontWeight="SemiBold" FontSize="13" />
                          <TextBlock Text="{Binding Root}" Style="{StaticResource Small}" FontSize="12" Margin="0,5,0,0" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <Button Content="Use this installation" HorizontalAlignment="Left" Click="ChooseClick" IsEnabled="{Binding CanRun}" Margin="0,8,0,0" />
                </StackPanel>
              </StackPanel>
            </Border>
            <Grid Margin="0,18,0,18">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="PICK UP WHERE YOU LEFT OFF" Style="{StaticResource Eyebrow}" Foreground="#96D8C8" />
                  <TextBlock Text="Your existing saves" FontSize="20" FontWeight="SemiBold" Margin="0,13,0,9" />
                  <TextBlock Text="Play opens your installed SPORE with your normal Windows account and existing saves." Style="{StaticResource Small}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="ABOUT SPOREMP" Style="{StaticResource Eyebrow}" />
                  <TextBlock Text="{Binding VersionLabel, StringFormat='Development build {0}'}" FontSize="20" FontWeight="SemiBold" Margin="0,13,0,9" />
                  <TextBlock Text="Multiplayer is still in development. Follow the changes as the project evolves." Style="{StaticResource Small}" />
                  <Button Content="Read release notes  →" Style="{StaticResource QuietButton}" Foreground="{StaticResource Accent}" HorizontalAlignment="Left" Click="ReadLatestClick" Margin="-10,9,0,-5" FontSize="12" />
                </StackPanel>
              </Border>
            </Grid>
            <Border x:Name="WorkerCard" Style="{StaticResource Card}" Margin="0,0,0,18" DataContext="{Binding Workers}">
              <StackPanel>
                <TextBlock Text="ISOLATED WORKERS · EXPERIMENTAL" Style="{StaticResource Eyebrow}" />
                <TextBlock Text="Run a local worker." FontSize="22" FontWeight="SemiBold" Margin="0,10,0,6" />
                <TextBlock Text="{Binding DesktopRequirement}" Style="{StaticResource Small}" Margin="0,0,0,15" />
                <ComboBox x:Name="WorkerBox" ItemsSource="{Binding Workers}" SelectedItem="{Binding Selected}" DisplayMemberPath="Label"
                          IsEnabled="{Binding CanSelect}" AutomationProperties.Name="Isolated worker" />
                <TextBlock Text="{Binding Status}" FontSize="16" FontWeight="SemiBold" Margin="0,15,0,5" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="{Binding Detail}" Style="{StaticResource Small}" />
                <WrapPanel Margin="0,17,0,0">
                  <Button x:Name="StartWorkerButton" Content="Start worker" Click="StartWorkerClick" IsEnabled="{Binding CanStart}" Margin="0,0,10,0" />
                  <Button x:Name="StopWorkerButton" Content="Stop worker" Click="StopWorkerClick" IsEnabled="{Binding CanStop}" Margin="0,0,10,0" Style="{StaticResource QuietButton}" />
                  <Button Content="Refresh status" Click="RefreshWorkersClick" IsEnabled="{Binding CanRefresh}" Style="{StaticResource QuietButton}" />
                </WrapPanel>
                <TextBlock Text="{Binding Message}" Style="{StaticResource Small}" FontSize="12" Margin="0,12,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="23,18">
              <Expander Foreground="{StaticResource Text}" ExpandDirection="Down" HorizontalContentAlignment="Stretch">
                <Expander.Header>
                  <StackPanel Margin="8,0,0,0">
                    <TextBlock Text="Troubleshooting" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="Installation details and local support reports" Style="{StaticResource Small}" FontSize="12" Margin="0,4,0,0" />
                  </StackPanel>
                </Expander.Header>
                <StackPanel Margin="31,20,0,0">
                  <TextBlock Text="{Binding FilesDetail}" Style="{StaticResource Small}" />
                  <TextBlock Text="{Binding TechnicalDetail}" Style="{StaticResource Small}" Margin="0,12,0,0" />
                  <Button Content="Export support report" Click="ExportClick" IsEnabled="{Binding CanExport}" HorizontalAlignment="Left" Margin="0,20,0,11" />
                  <TextBlock Text="{Binding ExportDetail}" FontSize="12" Foreground="#96D8C8" />
                  <TextBlock Text="Reports stay on this PC and contain no saves or game assets." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,10,0,0" />
                </StackPanel>
              </Expander>
            </Border>
            <Grid Margin="0,20,0,0">
              <TextBlock Text="Original launcher illustration. Not a gameplay screenshot." FontSize="10" Foreground="#8395AF" />
              <TextBlock Text="Ctrl+1 Home   ·   Ctrl+2 What's new   ·   Ctrl+, Settings" FontSize="10" Foreground="#8395AF" HorizontalAlignment="Right" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Border>
</Window>
