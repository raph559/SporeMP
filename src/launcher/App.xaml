<Application x:Class="SporeMP.Launcher.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Muted" Color="#B3BDD0" />
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Foreground" Value="#F5F4F0" /></Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#F5F4F0" /><Setter Property="Background" Value="#26364D" />
      <Setter Property="Padding" Value="16,11" /><Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" /><Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8" /></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#F4CE88" /></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.5" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="#C4CDDA" /><Setter Property="FontWeight" Value="Normal" /><Setter Property="Padding" Value="10,8" /></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#111F33" /><Setter Property="Foreground" Value="#EDF3FF" /><Setter Property="CaretBrush" Value="#F4CE88" /><Setter Property="BorderBrush" Value="#34445A" /><Setter Property="Padding" Value="10" /><Setter Property="FontSize" Value="12" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    <Style x:Key="Small" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}" /><Setter Property="FontSize" Value="13" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="LineHeight" Value="20" /></Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8" /><Setter Property="Background" Value="Transparent" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Grid Background="Transparent"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
          <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#4A607A" CornerRadius="4" Margin="2,0" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
        </Track></Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Application.Resources>
</Application>
